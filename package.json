{
  "name": "above-ground",
  "version": "1.9.0",
  "private": true,
  "description": "A calm app with research-based exercises for anxiety, depression and grounding. Web, iOS and Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-version.mjs && vite build",
    "preview": "vite preview",
    "native": "npm run build && node scripts/sync-native-version.mjs && cap sync",
    "ios": "npm run native && cap open ios",
    "android": "npm run native && cap open android",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#d8c6b2\" --iconBackgroundColorDark \"#d8c6b2\" --splashBackgroundColor \"#d8c6b2\" --splashBackgroundColorDark \"#d8c6b2\"",
    "preview:ios": "bash scripts/preview-ios.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/text-zoom": "^8.0.1",
    "@capgo/native-purchases": "^8.9.16",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@scure/bip39": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "vite": "^8.3.8"
  }
}
